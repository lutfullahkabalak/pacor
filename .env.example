# Portainer Stack ortam degiskenleri
# Portainer > Stacks > Add stack > Environment variables bolumune ekleyin.

POSTGRES_USER=oruc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=oruc

JWT_SECRET=change-me-long-random-secret
SESSION_GAP_MINUTES=30
JWT_EXPIRY_HOURS=168

HTTP_PORT=80

# Portainer deploy:
# 1. Stacks > Add stack
# 2. Repository: https://github.com/lutfullahkabalak/pacor
# 3. Compose path: docker-compose.portainer.yml
# 4. Yukaridaki degiskenleri ekle (POSTGRES_PASSWORD ve JWT_SECRET mutlaka degistir)
# 5. Deploy the stack
