# Portainer Stack ortam degiskenleri
# Portainer > Stacks > Add stack > Environment variables

POSTGRES_USER=oruc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=oruc

JWT_SECRET=change-me-long-random-secret
SESSION_GAP_MINUTES=30
JWT_EXPIRY_HOURS=168

HTTP_PORT=5843
BACKEND_PORT=5844
IMAGE_TAG=latest

# GHCR image'lari (GitHub Actions publish workflow ile uretilir):
#   ghcr.io/lutfullahkabalak/pacor-backend:latest
#   ghcr.io/lutfullahkabalak/pacor-nginx:latest
#
# pacor-nginx = Vue build + nginx reverse proxy (tek domain giris noktasi)
# backend ve db sadece ic agda, disari acik degil

# Portainer deploy:
# 1. Stacks > Add stack > Git repository
# 2. Repository: https://github.com/lutfullahkabalak/pacor
# 3. Compose path: docker-compose.portainer.yml
# 4. POSTGRES_PASSWORD ve JWT_SECRET mutlaka degistir
# 5. GHCR private ise Registries > ghcr.io + GitHub PAT (read:packages)
# 6. Cloudflare Tunnel -> http://nginx:80 (container) veya host:5843
# 7. nginx:5843 (web+API), backend:5844 (dogrudan API, opsiyonel)
